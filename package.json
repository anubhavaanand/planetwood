{
  "name": "planetwood",
  "version": "1.0.0",
  "description": "A 3D messenger planet game",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"vite\"",
    "dev:server": "node server/index.js",
    "dev:server:wss": "NODE_ENV=development node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project chromium",
    "test:firefox": "playwright test --project firefox",
    "test:edge": "playwright test --project edge",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@carverjs/core": "^0.0.3",
    "jsonwebtoken": "^9.0.3",
    "peerjs": "^1.5.5",
    "playroomkit": "^0.0.96",
    "protobufjs": "^8.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.0",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.7",
    "selfsigned": "^2.4.1",
    "vite": "^8.1.0"
  }
}
